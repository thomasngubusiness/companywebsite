# ── Server ──
PORT=4000
NODE_ENV=production
# Comma-separated allowed origins for the browser (your site URL)
CORS_ORIGIN=https://www.example.com,http://localhost:5500

# ── Auth ──
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=8h
# Default admin (used by npm run create-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!Strong#2026

# ── Database (PostgreSQL) ──
# Render: use the INTERNAL Database URL (same region, no SSL needed).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Email (SMTP) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@example.com
SMTP_PASS=your_smtp_password
MAIL_FROM="[Company] Security <no-reply@example.com>"
MAIL_ADMIN=sales@example.com

# ── Google reCAPTCHA v2 (login) ──
# Create keys at https://www.google.com/recaptcha/admin
# Choose "Challenge (v2)" -> "I'm not a robot" checkbox. Add your domain(s).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
